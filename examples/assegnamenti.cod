// "sia" dichiara una variabile, opzionalmente con un valore iniziale.
sia nome = "Codice";
sia versione = 1;

stampa("Ciao da " + nome + "! Versione: " + versione);

// Senza valore iniziale, la variabile riceve "nullo".
sia non_inizializzata;
stampa("Variabile non inizializzata: ", non_inizializzata);

// Le variabili possono essere usate in espressioni aritmetiche.
sia a = 5;
sia b = 10;
sia somma = a + b;

stampa("La somma di " + a + " e " + b + " è: " + somma);

// "sia" è anche un'espressione: restituisce il valore appena assegnato,
// quindi può comparire ovunque sia atteso un valore, come un argomento.
stampa("Il doppio della somma è: ", sia doppio = somma * 2);

// La dichiarazione avviene comunque, anche dentro un'espressione più grande:
// "x" resta disponibile dopo, con il valore che le è stato assegnato.
stampa("(sia x = 5) * 2 fa: ", (sia x = 5) * 2);
stampa("E x è rimasta dichiarata con il valore: ", x);

// Una variabile già dichiarata può essere riassegnata con "=" (senza "sia").
sia contatore = 0;
contatore = contatore + 1;
stampa("Il contatore ora vale: ", contatore);

// Anche "=" è un'espressione: restituisce il valore assegnato, e può essere
// incatenata, assegnando lo stesso valore a più variabili in una volta sola.
// ("a" e "b" sono le stesse dichiarate più sopra.)
a = b = 10;
stampa("Ora a e b valgono entrambi: ", a, " ", b);

// Riassegnare un identificatore mai dichiarato è un errore:
// "sconosciuta = 1;" darebbe "Identificatore 'sconosciuta' non definito."

// Le funzioni sono valori come un altro: si possono assegnare a una
// variabile e poi chiamarle tramite quella variabile.
sia dire_ciao = stampa;
dire_ciao("Fantastico!");

// "cost" dichiara una costante: richiede sempre un valore iniziale
// (a differenza di "sia") e non può più essere riassegnata dopo.
cost PI = 3.14159265358979323846;
stampa("PI vale: ", PI);

// Riassegnare una costante è un errore:
// "PI = 3;" darebbe "Impossibile riassegnare la costante 'PI'."

// Anche ridichiarare lo stesso nome, con "sia" o "cost", è un errore:
// "cost PI = 3;" darebbe "L'identificatore 'PI' è già stato dichiarato."

