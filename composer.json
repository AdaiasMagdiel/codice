{
    "name": "adaiasmagdiel/codice",
    "description": "A small programming language with Italian keywords, built for learning language design and the Italian language.",
    "type": "project",
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Adaías Magdiel",
            "email": "adaiasmagdiell@gmail.com"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^3.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/pest --coverage --min=90"
    }
}
