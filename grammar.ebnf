Program         ::= { Statement } ;

Statement       ::= ExprStatement ;
ExprStatement   ::= AdditiveExpr , ";" ;

AdditiveExpr    ::= MultiplicativeExpr , { ( "+" | "-" ) , MultiplicativeExpr } ;

MultiplicativeExpr ::= UnaryExpr , { ( "*" | "/" ) , UnaryExpr } ;

UnaryExpr       ::= [ UnaryOperator ] , PrimaryExpr ;

UnaryOperator   ::= "-" | "+" ;

PrimaryExpr     ::= StringLiteral 
                  | CallExpr 
                  | Identifier 
                  | NullLiteral 
                  | BoolLiteral 
                  | FloatLiteral 
                  | IntLiteral 
                  | "(" , AdditiveExpr , ")" ;

CallExpr        ::= Identifier , "(" , [ ArgumentList ] , ")" ;
ArgumentList    ::= AdditiveExpr , { "," , AdditiveExpr } ;

Identifier      ::= ( Letter | "_" ) , { Letter | Digit | "_" } ;
StringLiteral   ::= '"' , { StringCharacter } , '"' ;
NullLiteral     ::= "nullo" ;
BoolLiteral     ::= "vero" | "falso" ;
IntLiteral      ::= "0" | ( NonZeroDigit , DigitGroup ) ;
FloatLiteral    ::= IntLiteral , "." , [ Digit , DigitGroup ] ;

Letter          ::= "a".."z" | "A".."Z" ;
NonZeroDigit    ::= "1".."9" ;
Digit           ::= "0" | NonZeroDigit ;
DigitGroup      ::= { [ "_" ] , Digit } ;

StringCharacter ::= ? any character except '"' and newline ? | EscapeSequence ;
EscapeSequence  ::= "\" , ( '"' | "\" | "n" | "t" | "r" ) ;
